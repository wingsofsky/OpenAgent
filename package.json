{
  "name": "openagent-workspace",
  "private": true,
  "version": "0.3.0",
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:deps": "knip --no-progress && dpdm --no-warning --no-tree -T --skip-dynamic-imports circular --exit-code circular:1 packages/cli/src/cli.ts \"modules/*/src/**/*.ts\"",
    "openagent": "node packages/cli/src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "dpdm": "^3.15.1",
    "knip": "^5.88.1",
    "typescript": "~5.8.3",
    "vitest": "^4.1.11"
  },
  "description": "Keep an AI-built project's context in plain documents that every agent session reads, and let your agent hand work to the other agent CLIs on your machine.",
  "license": "Apache-2.0"
}
